<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>se.financial-tracker</groupId>
	<artifactId>financial-tracker</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<!-- Adapters are modules of their own, depending on core (ADR-0005).
	     adapter-web arrives with the first controller. -->
	<modules>
		<module>core</module>
		<module>adapter-persistence</module>
		<module>app</module>
	</modules>

	<properties>
		<java.version>26</java.version>
		<spotless.version>3.10.0</spotless.version>
		<palantir-java-format.version>2.96.0</palantir-java-format.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>se.financial-tracker</groupId>
				<artifactId>core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>se.financial-tracker</groupId>
				<artifactId>adapter-persistence</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
							<style>PALANTIR</style>
							<!-- javadoc in this repo contains hand-laid-out <pre>{@code} blocks -->
							<formatJavadoc>false</formatJavadoc>
						</palantirJavaFormat>
						<removeUnusedImports/>
						<!-- everything else, then jakarta/javax/java, then static: IntelliJ's default layout -->
						<importOrder>
							<order>,jakarta|javax|java,\#</order>
						</importOrder>
						<trimTrailingWhitespace/>
						<endWithNewline/>
					</java>
					<markdown>
						<includes>
							<include>*.md</include>
							<include>docs/**/*.md</include>
						</includes>
						<flexmark>
							<emulationProfile>COMMONMARK</emulationProfile>
							<extensions>YamlFrontMatter,Tables</extensions>
							<formatterOptions>
								<rightMargin>90</rightMargin>
							</formatterOptions>
						</flexmark>
					</markdown>
				</configuration>
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
